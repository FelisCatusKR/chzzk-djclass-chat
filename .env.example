# Go server configuration (read from the environment or ./.env).

# Public origin: OAuth redirect_uri, widget URLs, Secure cookies/HSTS when https.
BASE_URL=https://your-domain.com

# Chzzk OAuth app (developers.chzzk.naver.com), scope: 채팅 메시지 조회
CHZZK_CLIENT_ID=your_chzzk_client_id
CHZZK_CLIENT_SECRET=your_chzzk_client_secret

# Encrypts stored Chzzk tokens (AES-256-GCM key = SHA-256 of this value).
# Set once; changing it makes every stored token undecryptable.
VARCHIVE_TOKEN_KEY=your_32_char_encryption_key

# Optional
# SQLITE_PATH=djclass.sqlite3   # container default: /data/djclass.sqlite3
# ADDR=:8000
# DEV=1                         # local only: demo viewers + /dev chat injection (needs a localhost BASE_URL)
